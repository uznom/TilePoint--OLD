# Database configuration
MYSQL_DATABASE=
MYSQL_HOST=
MYSQL_PASSWORD=
MYSQL_PORT=
MYSQL_USER=

# Security & Sessions
SECURITY_SECRET=
VITE_SECURITY_SECRET=

# SSL / TLS Certificate Paths (Optional)
# If left blank, defaults to key.pem and cert.pem in the project root.
# Example relative path: cert.pem or ./certs/cert.pem
# Example Windows absolute path: C:\Certificates\cert.pem or C:/Certificates/cert.pem
SSL_CERT_PATH=
SSL_KEY_PATH=
