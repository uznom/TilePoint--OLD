# ==============================================================================
# TilePoint ERP & POS - Production Environment Configuration Template
# ==============================================================================

# Server & Runtime Configuration
NODE_ENV=production
PORT=3000

# Security Secret (REQUIRED: Must be at least 32 characters long)
# Used for HMAC-SHA256 session token signatures and encryption
SECURITY_SECRET=your_minimum_32_character_security_secret_key_here!

# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tilepoint_db
MYSQL_CONNECTION_LIMIT=25
MYSQL_MAX_IDLE=10

# CORS Allowed Origins (Comma-separated list of allowed domains or * for public access)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional SSL/TLS Configuration (Set paths to enable HTTPS)
# SSL_KEY_PATH=./key.pem
# SSL_CERT_PATH=./cert.pem

# Optional Development Settings
# DISABLE_HMR=false
# FORCE_DEV=false
# ALLOW_LOCAL_RESET=false