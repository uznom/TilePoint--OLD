{
  "name": "tilepoint",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "node scripts/check-no-secrets.js && vite build",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "test:secrets": "node scripts/check-no-secrets.js",
    "test:backups": "node scripts/test_backup_endpoints.js",
    "test:degraded": "node scripts/test_degraded_recovery.js",
    "test:precommit": "node scripts/pre-commit-check.js",
    "test:passwords": "node scripts/test_password_migration.js",
    "test:sessions": "node scripts/test_session_security.js",
    "test:sql": "node scripts/test_sql_parameterization.js",
    "test:ratelimits": "node scripts/test_rate_limits_and_body_limits.js",
    "test:cart": "node scripts/test_cart_calculations.js",
    "test:vitest": "vitest run",
    "test": "node scripts/check-no-secrets.js && vitest run && node scripts/test_backup_endpoints.js && node scripts/test_degraded_recovery.js && node scripts/pre-commit-check.js && node scripts/test_password_migration.js && node scripts/test_session_security.js && node scripts/test_sql_parameterization.js && node scripts/test_rate_limits_and_body_limits.js && node scripts/test_cart_calculations.js"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@tanstack/react-query": "^5.102.8",
    "alasql": "^4.17.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.23.2",
    "papaparse": "^5.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.9.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "xlsx": "^0.18.5",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
